{
  "version": "1.0.0",
  "configurations": [
    {
      "name": "build_lib",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/ts-node",
      "args": [
        "--buildLibraries", "--buildOnly", "mockProject/ts2gd.json"
      ],
      "program": "main.ts",
      "cwd": "${workspaceRoot}",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    }
  ]
}